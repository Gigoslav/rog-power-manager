	optdepends = xorg-xrandr: X11 fallback refresh rate switching
	optdepends = iw: Wi-Fi power-save toggling on battery
	provides = rog-power-manager
	provides = rog-auto-power
	provides = rog-auto-power-git
	conflicts = rog-auto-power
	replaces = rog-auto-power
