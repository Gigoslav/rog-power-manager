pkgbase = rog-power-manager
	pkgdesc = ASUS ROG Strix Power Manager, Fan Control (silent/balanced/turbo/max), 60/240Hz switcher, live Wattage tray badge & GPU/MUX switcher (Native C++ / Qt6)
	pkgver = 0.4.2
	pkgrel = 1
	url = https://github.com/Gigoslav/rog-power-manager
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = gcc
	depends = qt6-base
	depends = power-profiles-daemon
	depends = libnotify
	optdepends = supergfxctl: GPU mode switching (Integrated / Hybrid / AsusMuxDgpu)
	optdepends = kscreen: Wayland/X11 display refresh rate switching via kscreen-doctor
	optdepends = xorg-xrandr: X11 fallback refresh rate switching
	optdepends = iw: Wi-Fi power-save toggling on battery
	provides = rog-power-manager
	provides = rog-auto-power
	provides = rog-auto-power-git
	conflicts = rog-auto-power
	replaces = rog-auto-power
	replaces = rog-auto-power-git

pkgname = rog-power-manager
