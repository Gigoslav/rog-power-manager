pkgbase = rog-power-manager
	pkgdesc = ASUS ROG Strix auto power manager, fan control (silent/balanced/turbo/max), 60/240Hz switcher, live Wattage tray badge & GPU/MUX switcher
	pkgver = 0.3.0
	pkgrel = 1
