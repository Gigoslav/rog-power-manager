# Selective root helper for ASUS ROG Strix GPU/MUX switching, battery charge
# threshold control, display/keyboard brightness, and hardware power-saving sysfs tunables.

set -e

set_pci_pm() {
  local mode="$1"
  for dev in 0000:02:00.0 0000:03:00.0 0000:04:00.0 0000:05:00.0 0000:06:00.0 0000:06:00.2; do
    if [ -w "/sys/bus/pci/devices/$dev/power/control" ]; then
      echo "$mode" > "/sys/bus/pci/devices/$dev/power/control" 2>/dev/null || true
    fi
  done
}

case "$1" in
  AsusMuxDgpu)
    echo 0 > /sys/devices/platform/asus-nb-wmi/gpu_mux_mode
    ;;
  Hybrid|Integrated)
    sed -i "s/\"mode\": \"[^\"]*\"/\"mode\": \"$1\"/" /etc/supergfxd.conf 2>/dev/null || true
    echo 1 > /sys/devices/platform/asus-nb-wmi/gpu_mux_mode 2>/dev/null || true
    ;;
  charge-limit)
    val="$2"
    if [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 20 ] && [ "$val" -le 100 ]; then
      echo "$val" > /sys/class/power_supply/BAT0/charge_control_end_threshold
    else
      echo "Invalid threshold (must be 20-100)" >&2
      exit 1
    fi
    ;;
  set-brightness)
    pct="$2"
    if [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -ge 0 ] && [ "$pct" -le 100 ]; then
      for bl in /sys/class/backlight/*; do
        if [ -f "$bl/max_brightness" ]; then
          max=$(cat "$bl/max_brightness")
          val=$(( pct * max / 100 ))
          echo "$val" > "$bl/brightness"
        fi
      done
    else
      echo "Invalid brightness percentage (must be 0-100)" >&2
      exit 1
    fi
    ;;
  set-kbd)
    val="$2"
    if [[ "$val" =~ ^[0-3]$ ]]; then
      for kbd in /sys/class/leds/*kbd_backlight*; do
        if [ -e "$kbd/brightness" ]; then
          echo "$val" > "$kbd/brightness"
        fi
      done
    else
      echo "Invalid keyboard backlight level (must be 0-3)" >&2
      exit 1
    fi
    ;;
  power-battery)
    [ -w /sys/devices/platform/asus-nb-wmi/panel_od ] && echo 0 > /sys/devices/platform/asus-nb-wmi/panel_od || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 0 > /sys/devices/system/cpu/cpufreq/boost || true
    [ -w /proc/sys/vm/dirty_writeback_centisecs ] && echo 1500 > /proc/sys/vm/dirty_writeback_centisecs || true
    set_pci_pm auto
    iw dev wlan0 set power_save on 2>/dev/null || true
    ;;
  power-usbc)
    [ -w /sys/devices/platform/asus-nb-wmi/panel_od ] && echo 0 > /sys/devices/platform/asus-nb-wmi/panel_od || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost || true
    [ -w /proc/sys/vm/dirty_writeback_centisecs ] && echo 500 > /proc/sys/vm/dirty_writeback_centisecs || true
    set_pci_pm auto
    iw dev wlan0 set power_save on 2>/dev/null || true
    ;;
  power-ac)
    [ -w /sys/devices/platform/asus-nb-wmi/panel_od ] && echo 1 > /sys/devices/platform/asus-nb-wmi/panel_od || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost || true
    [ -w /proc/sys/vm/dirty_writeback_centisecs ] && echo 500 > /proc/sys/vm/dirty_writeback_centisecs || true
    set_pci_pm auto
    iw dev wlan0 set power_save off 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {AsusMuxDgpu|Hybrid|Integrated|charge-limit <20-100>|set-brightness <0-100>|set-kbd <0-3>|power-battery|power-usbc|power-ac}" >&2
    exit 1
    ;;
esac
